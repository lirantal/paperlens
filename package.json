{
  "name": "paperlens",
  "version": "0.0.1",
  "packageManager": "pnpm@10.26.0",
  "description": "capture, track, and analyze academic paper citations",
  "types": "dist/main.d.mts",
  "type": "module",
  "bin": {
    "paperlens": "./dist/bin/cli.cjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/main.d.mts",
        "default": "./dist/main.mjs"
      },
      "require": {
        "types": "./dist/main.d.cts",
        "default": "./dist/main.cjs"
      },
      "default": "./dist/main.mjs"
    }
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.26.0"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "tsx src/bin/cli.ts",
    "build": "tsc && tsdown",
    "lint": "eslint . && pnpm run lint:markdown",
    "lint:markdown": "markdownlint -c .github/.markdownlint.yml -i '.git' -i '__tests__' -i '.github' -i '.changeset' -i 'CODE_OF_CONDUCT.md' -i 'CHANGELOG.md' -i 'docs/superpowers/**' -i 'node_modules' -i 'dist' '**/**.md'",
    "lint:markdown:fix": "markdownlint -c .github/.markdownlint.yml -i '.git' -i '__tests__' -i '.github' -i '.changeset' -i 'CODE_OF_CONDUCT.md' -i 'CHANGELOG.md' -i 'docs/superpowers/**' -i 'node_modules' -i 'dist' '**/**.md' --fix",
    "lint:fix": "eslint . --fix",
    "test": "c8 node --import tsx --test __tests__/**/*.test.ts",
    "test:watch": "c8 node --import tsx --test --watch __tests__/**/*.test.ts",
    "coverage:view": "open coverage/lcov-report/index.html",
    "prepare": "husky",
    "version": "changeset version",
    "release": "changeset publish",
    "release:create": "changeset && git add .changeset && git commit -m \"chore: release\" && git push origin HEAD --no-verify"
  },
  "author": {
    "name": "Liran Tal",
    "email": "liran.tal@gmail.com",
    "url": "git+https://github.com/lirantal"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "license": "Apache-2.0",
  "keywords": [
    "arxiv"
  ],
  "homepage": "https://github.com/lirantal/paperlens",
  "bugs": {
    "url": "https://github.com/lirantal/paperlens/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lirantal/paperlens.git"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "c8": "^12.0.0",
    "eslint": "^10.2.1",
    "eslint-plugin-n": "^18.2.2",
    "eslint-plugin-security": "^4.0.0",
    "husky": "^9.0.11",
    "lint-staged": "^17.3.0",
    "markdownlint-cli": "0.49.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0",
    "validate-conventional-commit": "^1.0.4"
  },
  "lint-staged": {
    "**/*.{js,json}": [
      "pnpm run lint:fix"
    ]
  },
  "c8": {
    "exclude": [
      "dist/**",
      "coverage/**",
      "__tests__/**",
      "**/*.test.ts",
      "**/*.test.js"
    ],
    "include": [
      "src/**"
    ],
    "reporter": [
      "text",
      "lcov",
      "html"
    ]
  }
}
